# 本文件只声明变量名和非敏感本地默认值，不放入任何真实凭据。
SPRING_PROFILES_ACTIVE=local
# 变量名与 Spring local profile 保持一致；这些值只用于本地 compose。
ZIJI_DB_URL=jdbc:postgresql://localhost:5432/ziji
ZIJI_DB_USER=ziji
ZIJI_DB_PASSWORD=ziji-local
ZIJI_MAIL_HOST=localhost
ZIJI_MAIL_PORT=1025
ZIJI_MAIL_FROM=noreply@ziji.local
ZIJI_STORAGE_ENDPOINT=http://localhost:9000
ZIJI_STORAGE_ACCESS_KEY=ziji-local
ZIJI_STORAGE_SECRET_KEY=ziji-local-secret
ZIJI_STORAGE_BUCKET=ziji-imports
ZIJI_THS_SMOKE_ENABLED=false
ZIJI_FX_PROVIDER_MODE=mock
# 账户游标与认证密钥都必须独立生成；不可复用到 HMAC、幂等或 KEK。
ZIJI_ACCOUNT_CURSOR_KEY_BASE64=
ZIJI_LIQUIDITY_HOLD_CURSOR_KEY_BASE64=
# 认证密钥仅示例版本/时长；启动前必须分别生成并填入限流 HMAC、匿名幂等 HMAC 与 KEK，不能复用值。
ZIJI_AUTH_HMAC_CURRENT_KEY_VERSION=2
ZIJI_AUTH_HMAC_CURRENT_KEY_BASE64=
ZIJI_AUTH_HMAC_PREVIOUS_KEY_VERSION=
ZIJI_AUTH_HMAC_PREVIOUS_KEY_BASE64=
ZIJI_AUTH_HMAC_PREVIOUS_KEY_RETENTION=48h
ZIJI_AUTH_IDEMPOTENCY_CURRENT_KEY_VERSION=2
ZIJI_AUTH_IDEMPOTENCY_CURRENT_KEY_BASE64=
ZIJI_AUTH_IDEMPOTENCY_PREVIOUS_KEY_VERSION=
ZIJI_AUTH_IDEMPOTENCY_PREVIOUS_KEY_BASE64=
ZIJI_AUTH_IDEMPOTENCY_PREVIOUS_KEY_RETENTION=168h
ZIJI_AUTH_ENVELOPE_KEK_VERSION=1
ZIJI_AUTH_ENVELOPE_KEK_BASE64=
ZIJI_AUTH_TRUSTED_PROXY_ADDRESSES=
# Access Token 签名密钥仅为变量映射；值必须由本地临时文件或密钥管理系统提供，不得提交。
ZIJI_AUTH_ACCESS_TOKEN_CURRENT_KID=local-rs256-1
ZIJI_AUTH_ACCESS_TOKEN_CURRENT_PRIVATE_KEY_PKCS8_BASE64=
ZIJI_AUTH_ACCESS_TOKEN_CURRENT_PUBLIC_KEY_X509_BASE64=
ZIJI_AUTH_ACCESS_TOKEN_PREVIOUS_KID=
ZIJI_AUTH_ACCESS_TOKEN_PREVIOUS_PUBLIC_KEY_X509_BASE64=
ZIJI_AUTH_ACCESS_TOKEN_PREVIOUS_PUBLIC_KEY_RETENTION=24h
